# be2-mcp 環境變數範本 —— 交給平台 config-manager 的唯一依據
#
# 對齊 config-manager 兩塊 dotenv：
#   [APP CONFIG] 非機密 → k8s ConfigMap
#   [APP SECRET] 機密   → k8s Secret（config-manager 注入，永不 commit / 永不印出）
#
# 命名全面對齊平台（一環境一份 config，無多環境 preset、key 不帶環境前綴）。
# host 直接由 AUTHSVC_URL / GATEWAY_URL 給；環境差異由平台各注入一份。


# ======================================================================
# [APP CONFIG] 非機密 → k8s ConfigMap
# ======================================================================

# KKday
APP_ENV=stage
APP_PORT=8787

# --- 外部服務 host（一環境一份，直接指定；不再靠 preset 帶入）---
AUTHSVC_URL=https://auth.stage.kkday.com
GATEWAY_URL=https://api-gateway.stage.kkday.com

# --- 上雲硬阻斷（不設 pod 起不來 / OAuth 斷）---
APP_BIND_HOST=0.0.0.0
APP_ALLOWED_HOSTS=be2-mcp.stage.kkday.com
APP_BASE_URL=https://be2-mcp.stage.kkday.com

# --- 儲存（PostgreSQL，外部 RDS；runtime 零 DDL，schema 由 `npm run db:migrate` 管）---
# 二選一：DATABASE_URL（本機便利，短路下面四項）或 DB_HOST/PORT/USER/NAME 分開注入。
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DB_HOST=postgres.internal.kkday.com
DB_PORT=5432
DB_USER=be2mcp_app
DB_NAME=be2mcp_stage
# DB_PASSWORD 見下方 [APP SECRET] 區塊（runtime secret）

# --- 排程（cloud-ready 約束 #8：排程走 HTTP endpoint，非 in-process timer）---
# http = EKS/config-manager 部署預設（外部 CronJob 打 POST /api/jobs/oauth-purge、
# POST /api/jobs/scheduler-tick，帶 CRON_SECRET bearer，process 內不跑 setTimeout 迴圈）；
# poller = 本機/PoC 專用（app 進程內 in-process tick，免 CronJob 依賴）——本檔頭「交給
# config-manager 的唯一依據」指的是雲端部署值，本機開發請在自己的 .env 覆寫成 poller
# （見檔尾「本地開發」區塊）。
SCHEDULER_MODE=http

# --- 可觀測性 ---
OTEL_MODE=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- 其他 ---
# audit stdout 雙寫（EKS 部署設 true，Filebeat 收進 Kibana；本地可不設）
APP_AUDIT_STDOUT=false
# Express trust proxy（ALB/ingress 後方設 1；本地不設）
# APP_TRUST_PROXY=1
APP_TZ=Asia/Taipei
# APP_DEV_PANEL 務必不設（=1 才開 dev 面板，stage/prod 禁用）


# ======================================================================
# [APP SECRET] 機密 → k8s Secret（config-manager 注入）
# ======================================================================

# auth-service S2S service key（單把，該環境的）
# ★stage / prod 版 repo 尚無，需向 auth-service team 申請★
API_AUTH_SERVICE_KEY="REF FROM ENV"

# PostgreSQL 連線密碼（DB_HOST/PORT/USER/NAME 見上方 [APP CONFIG]；DATABASE_URL 走法則整串是機密）
DB_PASSWORD="REF FROM ENV"

# 外部 cron（k8s CronJob）打 POST /api/jobs/oauth-purge、/api/jobs/scheduler-tick 帶的 bearer
# （SCHEDULER_MODE=http 時才需要；poller 模式可留空）
CRON_SECRET="REF FROM ENV"

# 公告（svc-b2c）api key；僅啟用 announcement 寫入才需要
# API_ANNOUNCE_KEY="REF FROM ENV"

# --- 僅本機 script 用（bootstrap-user / probe-sit；主服務不讀、不上雲）---
# AUTH_email="REF FROM ENV"
# AUTH_pwd="REF FROM ENV"


# ======================================================================
# 本地開發 —— 複製本檔為 .env 後填實際值
# ======================================================================
# 打 SIT be2-220（照上面兩塊的順序排：上半 CONFIG、下半 SECRET）：
#   APP_ENV=sit
#   DATABASE_URL=postgres://test:test@localhost:55432/be2mcp_sit   # 本機 PG（docker/pg-test.yml）
#   AUTHSVC_URL=https://auth-220.sit.kkday.com
#   GATEWAY_URL=https://api-gateway-220.sit.kkday.com
#   APP_BIND_HOST=127.0.0.1        # 本地留 loopback
#   SCHEDULER_MODE=poller          # 本地/單實例維持 in-process tick
#   API_AUTH_SERVICE_KEY=<SIT service key>
#   API_ANNOUNCE_KEY=<SIT announce key，僅公告寫入需要>
#   AUTH_email=<SIT 測試帳號>      # 僅 script 用
#   AUTH_pwd=<SIT 測試密碼>        # 僅 script 用
