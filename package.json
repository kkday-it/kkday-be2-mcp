{
  "name": "be2-mcp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "eval": "tsx eval/run-eval.ts",
    "bootstrap-user": "tsx scripts/bootstrap-user.ts",
    "probe-sit": "tsx scripts/probe-sit.ts",
    "probe-sit-write": "tsx scripts/probe-sit-write.ts",
    "probe-sit-inventory": "tsx scripts/probe-sit-inventory.ts",
    "probe-sit-bm": "tsx scripts/probe-sit-bluemountain.ts",
    "oauth-purge": "tsx scripts/oauth-purge.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "tsc -p tsconfig.build.json && npm run build:ui",
    "start": "node dist/src/index.js",
    "lint:async": "node tools/lint/node_modules/eslint/bin/eslint.js --config tools/lint/eslint.config.mjs src scripts",
    "postinstall": "npm ci --prefix tools/lint --no-audit --no-fund",
    "ci": "npm run build && npm run typecheck && npm run lint:async && npm run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
